{
  "name": "cortico-world-spotify-lyrics",
  "version": "0.3.3",
  "type": "module",
  "description": "在 macOS 上读取 Spotify 的曲目与播放位置，让 Coopanion 的桌宠按句唱出歌词并持续跳舞。歌词来自 LRCLIB，支持本地 lrc 覆盖。",
  "author": "AsakusaCC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsakusaCC/coopanion-spotify-lyrics.git"
  },
  "homepage": "https://github.com/AsakusaCC/coopanion-spotify-lyrics#readme",
  "bugs": {
    "url": "https://github.com/AsakusaCC/coopanion-spotify-lyrics/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "spotify",
    "lyrics",
    "desktop-pet",
    "macos"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Spotify 跟唱",
    "icon": "icon.svg",
    "describe": "describe.json",
    "tags": [
      "apps",
      "internet",
      "external-setup",
      "sensitive-data",
      "experimental"
    ]
  },
  "files": [
    "src",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
